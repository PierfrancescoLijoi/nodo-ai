<policies>
  <inbound>
    <!-- The probe of Front Door and of the availability test. Deliberately no <base />: the API-level
         policy demands a token, and a probe has none. The network rule already admits only Front Door;
         the response says nothing a stranger could use. -->
    <rate-limit-by-key calls="240" renewal-period="60" counter-key="@(context.Request.IpAddress)" />
    <set-backend-service backend-id='@(context.Deployment.Region == "${primary_region_display}" ? "api-primary" : "api-dr")' />
  </inbound>
  <backend>
    <forward-request timeout="10" />
  </backend>
  <outbound />
  <on-error />
</policies>
