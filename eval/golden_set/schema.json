{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nodo.example.invalid/schemas/golden-set.json",
  "title": "NODO AI golden set",
  "$defs": {
    "localizedQuestion": {
      "type": "object",
      "required": ["en", "pl", "it", "da"],
      "additionalProperties": false,
      "properties": {
        "en": {"type": "string", "minLength": 1},
        "pl": {"type": "string", "minLength": 1},
        "it": {"type": "string", "minLength": 1},
        "da": {"type": "string", "minLength": 1}
      }
    },
    "case": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "category", "workspace_id", "caller_user_id", "question", "expected_answerability", "expected_citation_segment_ids", "forbidden_segment_ids", "notes"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "category": {"enum": ["single_meeting_fact", "decision_change_over_time", "speaker_ambiguity", "multilingual_cross_lingual", "incomplete_reference", "unanswerable", "entity_collision", "false_cross_project_join", "acl_negative", "deleted_data"]},
        "workspace_id": {"type": "string", "minLength": 1},
        "caller_user_id": {"type": "string", "minLength": 1},
        "question": {"oneOf": [{"type": "string", "minLength": 1}, {"$ref": "#/$defs/localizedQuestion"}]},
        "expected_answerability": {"enum": ["supported", "partial", "unanswerable"]},
        "expected_citation_segment_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "forbidden_segment_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "notes": {"type": "string"}
      }
    },
    "segment": {
      "type": "object",
      "required": ["id", "speaker", "start_ms", "end_ms", "version", "text"],
      "properties": {
        "id": {"type": "string"},
        "speaker": {"type": "string"},
        "start_ms": {"type": "integer", "minimum": 0},
        "end_ms": {"type": "integer", "minimum": 0},
        "version": {"type": "integer", "minimum": 1},
        "text": {"type": "string"},
        "tombstoned": {"type": "boolean"},
        "tombstoned_at": {"type": "string", "format": "date-time"}
      }
    },
    "meeting": {
      "type": "object",
      "required": ["id", "workspace_id", "project_id", "title", "spoken_language", "started_at", "segments"],
      "properties": {
        "id": {"type": "string"},
        "workspace_id": {"type": "string"},
        "project_id": {"type": "string"},
        "title": {"type": "string"},
        "spoken_language": {"enum": ["en", "pl", "it", "da"]},
        "started_at": {"type": "string", "format": "date-time"},
        "segments": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/segment"}}
      }
    }
  },
  "type": "object",
  "required": ["meetings"],
  "properties": {
    "meetings": {"type": "array", "items": {"$ref": "#/$defs/meeting"}}
  }
}

