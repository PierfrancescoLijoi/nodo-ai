ant&lt;br&gt;NAT gateway for egress&lt;/span&gt;' style="shape=label;rounded=1;arcSize=9;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#94A3B8;strokeWidth=3;image=img/lib/azure2/other/Container_App_Environments.svg;imageAlign=center;imageVerticalAlign=top;imageWidth=50;imageHeight=50;verticalAlign=bottom;spacingBottom=10;spacingTop=8;spacingLeft=6;spacingRight=6;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="1465" y="520" width="270" height="145" as="geometry"/></mxCell><mxCell id="c9" value='&lt;b style="font-size:18px;color:#0F172A"&gt;Container Registry&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:13px;color:#475569"&gt;Geo-replicated to standby&lt;br&gt;Images scanned in CI&lt;/span&gt;' style="shape=label;rounded=1;arcSize=9;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#94A3B8;strokeWidth=3;image=img/lib/azure2/containers/Container_Registries.svg;imageAlign=center;imageVerticalAlign=top;imageWidth=50;imageHeight=50;verticalAlign=bottom;spacingBottom=10;spacingTop=8;spacingLeft=6;spacingRight=6;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="1755" y="520" width="270" height="145" as="geometry"/></mxCell><mxCell id="c10" value='&lt;b style="font-size:18px;color:#0F172A"&gt;Private endpoints&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:13px;color:#475569"&gt;Vault · registry · storage&lt;br&gt;Queue · search · models&lt;/span&gt;' style="shape=label;rounded=1;arcSize=9;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#94A3B8;strokeWidth=3;image=img/lib/azure2/other/Private_Endpoints.svg;imageAlign=center;imageVerticalAlign=top;imageWidth=50;imageHeight=50;verticalAlign=bottom;spacingBottom=10;spacingTop=8;spacingLeft=6;spacingRight=6;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="2045" y="520" width="270" height="145" as="geometry"/></mxCell><mxCell id="jobs" value='&lt;b style="font-size:18px;color:#0F172A"&gt;Scheduled jobs&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:13px;color:#475569"&gt;Retention · sweep 