 engine copies finished meetings to the cloud: PUT /v1/sync (idempotent)." style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fontColor=#44546A;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="50" y="530" width="210" height="70" as="geometry"/></mxCell><mxCell id="afd" value="Front Door Premium&lt;br&gt;+ WAF (bot, rate limits)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;strokeWidth=2;fontFamily=Helvetica;fontSize=14;fillColor=#DEEBF7;strokeColor=#0078D4;fontColor=#10243B;" vertex="1" parent="1"><mxGeometry x="345" y="150" width="240" height="90" as="geometry"/></mxCell><mxCell id="apim" value="API Management&lt;br&gt;one gateway: JWT check,&lt;br&gt;rate limit, policies,&lt;br&gt;request id" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;strokeWidth=2;fontFamily=Helvetica;fontSize=14;fillColor=#DEEBF7;strokeColor=#0078D4;fontColor=#10243B;" vertex="1" parent="1"><mxGeometry x="345" y="300" width="240" height="130" as="geometry"/></mxCell><mxCell id="tls" value="DNS, TLS, Private Link&lt;br&gt;to the gateway" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;strokeWidth=2;fontFamily=Helvetica;fontSize=14;fillColor=#DEEBF7;strokeColor=#0078D4;fontColor=#10243B;" vertex="1" parent="1"><mxGeometry x="345" y="490" width="240" height="90" as="geometry"/></mxCell><mxCell id="api" value="Container Apps: API&lt;br&gt;FastAPI, internal ingress,&lt;br&gt;bulkheads, load shedding" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;strokeWidth=2;fontFamily=Helvetica;fontSize=14;fillColor=#DEEBF7;strokeColor=#0078D4;fontColor=#10243B;" vertex="1" parent="1"><mxGeometry x="695" y="200" width="350" height="100" as="geometry"/></mxCell><mxCell id="sb" value="Service Bus Premium&lt;br&gt;queue, scheduled messages, Geo-DR" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;strokeWidth=2;fontFamily=Helvetica;fontSize=14;fillColor=#DEEBF7;strokeColor=#0078D4;fontColor=#10243B;" vertex="1" parent="1"><mxGeometry x="695" y="340" width="350" height="80" as="geometry"/></mxCell><mxCell id="worker" value="Container Apps job: worker&lt;br&gt;transcribe, analyse, export,&lt;br&gt;poll speech, reanalyse" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;strokeWidth=2;fontFamily=Helvetica;fontSize=14;fillColor=#DEEBF7;strokeColor=#0078D4;fontColor=#10243B;" vertex="1" parent="1"><mxGeometry x="695" y="460" width="350" height="100" as="geometry"/></mxCell><mxCell id="jobs" value="Scheduled jobs (own identity each)&lt;br&gt;retention, sweep, index verify&lt;br&gt;and reindex, audit archive,&lt;br&gt;migrate, preflight" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;strokeWidth=2;fontFamily=Helvetica;fontSize=14;fillColor=#DEEBF7;strokeColor=#0078D4;fontColor=#10243B;" vertex="1" parent="1"><mxGeometry x="695" y="600" width="350" height="150" as="geometry"/></mxCell><mxCell id="pg" value="PostgreSQL Flexible Server (HA, pgvector)&lt;br&gt;meetings, transcripts, graph, entity vectors,&lt;br&gt;answer cache, jobs, audit; row level security" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;strokeWidth=2;fontFamily=Helvetica;fontSize=14;fillColor=#E2F0D9;strokeColor=#548235;fontColor=#10243B;" vertex="1" parent="1"><mxGeometry x="1195" y="200" width="510" height="110" as="geometry"/></mxCell><mxCell id="blob" value="Blob Storage&lt;br&gt;audio, CMK, RA-GZRS&lt;br&gt;(read by the worker)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;strokeWidth=2;fontFamily=Helvetica;fontSize=14;fillColor=#E2F0D9;strokeColor=#548235;fontColor=#10243B;" vertex="1" parent="1"><mxGeometry x="1195" y="350" width="240" height="80" as="geometry"/></mxCell><mxCell id="search" value="AI Search&lt;br&gt;hybrid text + vector&lt;br&gt;(index written by the worker)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;strokeWidth=2;fontFamily=Helvetica;fontSize=14;fillColor=#E2F0D9;strokeColor=#548235;fontColor=#10243B;" vertex="1" parent="1"><mxGeometry x="1465" y="350" width="240" height="80" as="geometry"/></mxCell><mxCell id="audit" 